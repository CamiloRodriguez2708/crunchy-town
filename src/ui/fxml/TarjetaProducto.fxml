<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="230.0" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.controllers.TarjetaProductoController">
    <children>
        <StackPane minHeight="110.0" prefHeight="110.0" style="-fx-background-color: #fcbf49; -fx-background-radius: 12;">
            <children>
                <ImageView fx:id="imgProducto" fitHeight="90.0" pickOnBounds="true" preserveRatio="true" />
            </children>
        </StackPane>
        <Label fx:id="lblNombre" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
        <Label fx:id="lblDescripcion" style="-fx-font-size: 10px; -fx-text-fill: #666666;" wrapText="true" />
        <HBox alignment="CENTER_LEFT">
            <children>
                <Label fx:id="lblPrecio" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #d62828;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button maxHeight="28.0" maxWidth="28.0" minHeight="28.0" minWidth="28.0" mnemonicParsing="false" onAction="#agregar" style="-fx-background-color: #d62828; -fx-text-fill: white; -fx-background-radius: 50; -fx-padding: 0; -fx-font-weight: bold; -fx-cursor: hand;" text="+" />
            </children>
        </HBox>
    </children>
</VBox>
