<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER_LEFT" maxWidth="1000.0" minHeight="130.0" minWidth="1000.0" prefHeight="130.0" prefWidth="1000.0" spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(48,33,30,0.14), 8, 0, 0, 2);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.controllers.TarjetaPedidoController">
    <padding>
        <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
    </padding>
    <children>
      <AnchorPane maxHeight="62.0" maxWidth="62.0" minHeight="62.0" minWidth="62.0" prefHeight="62.0" prefWidth="62.0" style="-fx-background-color: #ffbf47; -fx-background-radius: 16;">
         <children>
            <ImageView fx:id="icono" fitHeight="62.0" fitWidth="62.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </AnchorPane>
        <VBox alignment="CENTER_LEFT" spacing="4.0" HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label fx:id="lbNombre" style="-fx-font-family: 'Carlito'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #30211e; -fx-padding: 2 10 2 1;" text="Camilo" />
                  <Label fx:id="lbDirrecion" style="-fx-font-family: 'Carlito'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #30211e; -fx-padding: 2 10 2 1;" text="Cr 14 N6 - 04" />
                        <Label fx:id="lbEstado" style="-fx-background-color: #fff0dc; -fx-background-radius: 10; -fx-padding: 2 10 2 10; -fx-font-family: 'Carlito'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #d62828;" text="PENDIENTE" />
                    </children>
                </HBox>
                <VBox fx:id="listaProductos" spacing="1.0">
                    <children>
                        <Label fx:id="lbProductos" style="-fx-font-family: 'Carlito'; -fx-font-size: 14px; -fx-text-fill: #715e57;" text="2× Hamburguesa clásica" />
                    </children>
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label fx:id="lbTotal" style="-fx-font-family: 'Carlito'; -fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #d62828;" text="\$ 140.000" />
                        <Label fx:id="lbPago" style="-fx-background-color: #fff8f0; -fx-background-radius: 10; -fx-padding: 2 10 2 10; -fx-font-family: 'Carlito'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #715e57;" text="Nequi" />
                    </children>
                </HBox>
            </children>
        </VBox>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button fx:id="btnAceptar" minHeight="46.0" minWidth="46.0" mnemonicParsing="false" onAction="#accionCheck" prefHeight="46.0" prefWidth="46.0" style="-fx-background-color: #2e9e5b; -fx-background-radius: 14; -fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-cursor: hand;" text="✓" />
                <Button fx:id="btnRechazar" minHeight="46.0" minWidth="46.0" mnemonicParsing="false" onAction="#accionX" prefHeight="46.0" prefWidth="46.0" style="-fx-background-color: #d62828; -fx-background-radius: 14; -fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-cursor: hand;" text="✕" />
            </children>
        </HBox>
    </children>
</HBox>
